generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// for user avatar images
model images {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  file_id String
  url     String
  userId  String? @unique @db.ObjectId
  shopId  String? @unique @db.ObjectId
  users   users?  @relation(fields: [userId], references: [id])
  shops   shops?  @relation(fields: [shopId], references: [id])
}

// for users model
model users {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String        @unique
  password    String?
  following   String[]
  avatar      images?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shopReviews shopReviews[]
}

model shopReviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId    String   @db.ObjectId
  userId    String   @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  rating    Float
  reviews   String?
  shops     shops?   @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model shops {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String
  category      String
  avatar        images?
  coverBanner   String?
  address       String
  opening_hours String?
  website       String?
  social_links  Json[]
  ratings       Float         @default(0)
  reviews       shopReviews[]
  sellerId      String        @unique @db.ObjectId
  sellers       sellers       @relation(fields: [sellerId], references: [id])
  taxId         String?
  businessType  String?
  zipCode       String
  city          String
  state         String
  country       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model sellers {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  password     String
  phone_number String
  country      String
  stripeId     String?
  shop         shops?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// site config
model site_configs {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  // Basic category system
  categories      String[]
  subCategories   Json
  // Brands & variations
  brands          String[]
  colors          Json[] // [{ name: "...", hex: "..." }]
  sizes           String[]
  // Price filtering ranges
  priceRanges     Json[] // [{ label: "...", min: 0, max: 100 }]
  // Delivery systems
  deliveryOptions Json[] // [{ name: "...", estimatedDays: 3 }]
  // Payment methods
  paymentMethods  String[]
  // App-level configuration
  appSettings     Json // { theme, currency, language, contactEmail, contactPhone }
  // Social media links
  socialLinks     Json // { facebook, instagram, youtube }
  // Banner sliders
  banners         Json[] // [{ id, title, image, link }]
}
